# 포트 (한 곳) — 셸: source config/ports.env · 파이썬: from pitron.ports import PORTS, url · 화면: 서버가 __PORT_이름__ 을 바꿔 넣음
PORT_ROBOT_SERVER=50000        # 박스 핸드오버 제어 화면 (apps/box_handover/robot_server.py)
PORT_RS_STREAM=50001           # D435i 영상 · 깊이 (services/camera/rs_stream.py)
PORT_DASHBOARD=50003           # 3D 로봇 뷰 (services/dashboard/dashboard.py)
PORT_DETECT_BOX=50010          # 박스 인식 (apps/box_handover/detect_box.py) — 가상 카메라 시뮬에서는 sim_server 가 대신
PORT_SIM_BOX=50012             # 박스 시뮬 조작 화면 (apps/box_handover/sim_server.py, 실물 카메라 모드)
PORT_HEAD_TRACK=50013          # 머리 카메라 사람 인식 (services/head_vision/head_track.py)
PORT_HEAD_CAM_CHECK=50014      # 머리 카메라 점검 (tools/check_head_cam.py --web)
PORT_DEPTH_CHECK=50015         # 깊이 점검 (tools/check_depth.py)
PORT_DEPTH_TELEIMAGER=50016    # 깊이 점검 teleimager (tools/check_depth_teleimager.py)
PORT_ARM_SERVER=50022          # 팔 소유자 (services/arm/arm_server.py)
PORT_PICK_WEB=50030            # 그리퍼 잡기 · 수집 · 추론 (apps/gripper_pick/pick_web.py)
PORT_XR_VIEWER=50040           # VR 가상 팔 3D 보기 (apps/gripper_pick/xr_viewer.py)
PORT_XR_VUER=8012              # Quest 입력 Vuer (xr_teleoperate televuer)
PORT_TRAINER=50100             # ACT 학습 웹 (apps/trainer/trainer_server.py, 학습 PC)
PORT_EDITOR=8000               # 모션 에디터 (apps/motion_editor/simulator.py)
PORT_ACT_VIEWER=8800           # ACT 데이터셋 · 모델 보기 (apps/act_viewer, 전시 PC)
PORT_LAUNCHER=80               # 웹 런처 (apps/launcher/run_launcher.py, sudo)
